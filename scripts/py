#!/usr/bin/env python3
"""Run a command with this repo's Python, on macOS, Linux and Windows.

The virtual environment keeps its Python in .venv/bin/python on macOS and
Linux, and in .venv\\Scripts\\python.exe on Windows. This launcher finds the
right one, so every step can use the same words on every system:

    python3 scripts/py solver.py              macOS and Linux
    py -3 scripts/py solver.py                Windows (or: python scripts/py ...)

Everything after scripts/py goes to the venv's Python, which runs from the
repo root. So a script path is relative to the repo root, and "-m module"
works too. The exit code is the command's exit code.

On the first run the launcher makes .venv with the Python that started it,
then installs requirements.txt. Later runs skip both steps.

Options, before the command:

    --setup    make the venv and install, then stop
    --dev      also install requirements-dev.txt (pytest), for the tests:
               python3 scripts/py --dev -m pytest tests/
    --where    print the path of the venv's Python, then stop

The file has no .py ending on purpose, so no "import py" can load it.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

MIN_PYTHON = (3, 9)
REPO = Path(__file__).resolve().parent.parent
VENV = REPO / ".venv"
OPTIONS = {"--setup", "--dev", "--where", "-h", "--help"}


def venv_python() -> Path:
    if os.name == "nt":
        return VENV / "Scripts" / "python.exe"
    return VENV / "bin" / "python"


def say(message: str) -> None:
    print(f"scripts/py: {message}", file=sys.stderr, flush=True)


def can_import(python: Path, module: str) -> bool:
    result = subprocess.run(
        [str(python), "-c", f"import {module}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def pip_install(python: Path, requirements: str) -> None:
    say(f"installing {requirements} into .venv (one time)")
    subprocess.run(
        [
            str(python),
            "-m",
            "pip",
            "install",
            "--quiet",
            "--disable-pip-version-check",
            "-r",
            str(REPO / requirements),
        ],
        check=True,
    )


def ensure_venv(dev: bool) -> Path:
    python = venv_python()
    if not python.exists():
        if sys.version_info < MIN_PYTHON:
            raise SystemExit(
                f"scripts/py: Python {MIN_PYTHON[0]}.{MIN_PYTHON[1]} or newer is needed, "
                f"and this is {sys.version.split()[0]}. Install a newer Python from "
                "https://www.python.org/downloads/ and run the command again."
            )
        say(f"making .venv with Python {sys.version.split()[0]} (one time)")
        # --clear repairs a .venv whose Python is gone, for example after an upgrade.
        subprocess.run([sys.executable, "-m", "venv", "--clear", str(VENV)], check=True)
    if not can_import(python, "ortools"):
        pip_install(python, "requirements.txt")
    if dev and not can_import(python, "pytest"):
        pip_install(python, "requirements-dev.txt")
    return python


def main(argv: list[str]) -> int:
    flags = set()
    while argv and argv[0] in OPTIONS:
        flags.add(argv.pop(0))
    if flags & {"-h", "--help"}:
        print(__doc__)
        return 0
    if not argv and not flags & {"--setup", "--dev", "--where"}:
        say("name a command to run, for example: scripts/py solver.py")
        return 2

    try:
        python = ensure_venv(dev="--dev" in flags)
    except subprocess.CalledProcessError as exc:
        say(f"setup failed (exit {exc.returncode}). Delete .venv and run the command again.")
        return exc.returncode or 1
    if "--where" in flags:
        print(python)
        return 0
    if not argv:
        return 0

    # UTF-8 mode: every CSV and HTML file here is UTF-8, and a Windows
    # console or pipe would otherwise use the local code page.
    env = dict(os.environ)
    env.setdefault("PYTHONUTF8", "1")
    try:
        return subprocess.call([str(python), *argv], cwd=REPO, env=env)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
